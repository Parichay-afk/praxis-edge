---
/* The wordmark is DM Serif Display 34px, letter-spacing -0.5, baseline y=30,
   "edge" at x=108 — outlined to paths (HarfBuzz-shaped, so kerning matches
   what the browser produced from <text>). Outlining removes the logo's
   dependency on the web font: it paints at first render, never in the
   fallback serif, and doesn't re-stamp LCP when the font swaps in. */
type Props = {
  height?: number;
  variant?: 'light' | 'muted';
};

const { height = 30, variant = 'light' } = Astro.props;
const leftFill = variant === 'muted' ? '#9a9a9a' : '#c0b8d8';
const rightFill = variant === 'muted' ? '#7c55f5' : '#fff';
const strokeFill = variant === 'muted' ? '#7c55f5' : '#fff';
